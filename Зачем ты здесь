-- Q / «Пушка» — достать · клик мыши / «ПОРТАЛ» — выстрел · подойдите к порталу вплотную — пройти.
-- На R15 рука поднимается при прицеливании. Ошибки показываются на экране под кнопками и в Output.
print("[PortalGun] скрипт запущен")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local WS = game:GetService("Workspace")

local plr = Players.LocalPlayer
if not plr then
	warn("[PortalGun] Это Script, а нужен LocalScript (StarterPlayer → StarterPlayerScripts)")
	return
end
local pg = plr:WaitForChild("PlayerGui", 15)
if not pg then
	warn("[PortalGun] Нет PlayerGui")
	return
end

local V = Vector3.new
local PW, PH = 5.2, 8
local LIGHT, LIGHT2, GREYD = Color3.fromRGB(206, 207, 212), Color3.fromRGB(180, 182, 188), Color3.fromRGB(120, 122, 130)
local BLACK, RED = Color3.fromRGB(28, 28, 32), Color3.fromRGB(225, 40, 40)
local LIME, GREEN, DGREEN = Color3.fromRGB(150, 255, 70), Color3.fromRGB(60, 210, 60), Color3.fromRGB(18, 100, 36)
local NEON, CYL, BALL = Enum.Material.Neon, Enum.PartType.Cylinder, Enum.PartType.Ball
local UP = CFrame.Angles(0, 0, math.rad(90))

local char, hum, root, gun, shoulderC0
local fovAdd = 0
local equipped = false
local portals, dying, beams = {}, {}, {}
local nextSlot, tpCd, fireCd, kick, flash, tpFlash = 1, 0, 0, 0, 0, 0
local touchOnly = UIS.TouchEnabled and not UIS.MouseEnabled

