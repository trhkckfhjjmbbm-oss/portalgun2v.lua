	local b = Instance.new("TextButton")
	b.Text, b.Size, b.Position = text, size, pos
	b.BackgroundColor3, b.BackgroundTransparency, b.BorderSizePixel = Color3.fromRGB(16, 22, 16), 0.1, 0
	b.Font, b.TextSize, b.TextColor3 = Enum.Font.GothamBold, 14, LIME
	local c = Instance.new("UICorner")
	c.CornerRadius = round and UDim.new(1, 0) or UDim.new(0, 8)
	c.Parent = b
	local s = Instance.new("UIStroke")
	s.Color, s.Thickness, s.ApplyStrokeMode = LIME, 1.4, Enum.ApplyStrokeMode.Border
	s.Parent = b
	b.Parent = gui
	return b
end

local btnGun = button("Пушка: ВЫКЛ", UDim2.new(0, 12, 0.3, 0), UDim2.fromOffset(130, 36))
local btnClose = button("Закрыть порталы", UDim2.new(0, 12, 0.3, 42), UDim2.fromOffset(130, 36))
